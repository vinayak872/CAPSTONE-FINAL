# CLOUD-05 Environment Configuration Example
PORT=5005
HOST=0.0.0.0
NODE_ENV=development

# Infrastructure Mode: 'simulation' or 'kubernetes'
EXECUTION_MODE=simulation

# Kubernetes / Cluster Configuration (optional in simulation mode)
KUBERNETES_NAMESPACE=cloud05-app
ARGO_ROLLOUT_NAME=cloud05-service

# Paths
FRONTEND_PATH=../frontend
RELEASE_CONFIG_PATH=./release_config.json

# Telemetry
PROMETHEUS_METRICS_ENABLED=true
